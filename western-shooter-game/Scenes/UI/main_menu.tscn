[node name="CreateButton" type="Button" parent="Margin/Layout/Bottom/PlayPanel/VBox/LocalRow"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
tooltip_text = "Host a game on this PC with the selected mode. It shows up for players on your network."
theme_override_font_sizes/font_size = 15
