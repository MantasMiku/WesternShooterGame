popup/item_6/text = "6 bots"
popup/item_6/id = 6
popup/item_7/text = "7 bots"
popup/item_7/id = 7

[node name="UpnpToggle" type="Button" parent="Margin/Layout/Bottom/PlayPanel/VBox/LocalRow"]
